{
  "private": true,
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "build": "cargo xtask build",
    "build:occt": "cargo xtask build-occt",
    "test": "cd ts && npx vitest run",
    "test:bundler": "node scripts/bundler-smoke.mjs",
    "lint": "cd ts && npx eslint src/",
    "typecheck": "cd ts && npx tsgo --noEmit",
    "typecheck:tests": "cd ts && npx tsgo --noEmit -p ../tsconfig.test.json",
    "typecheck:docs": "node scripts/check-doc-snippets.mjs",
    "publish:dry": "./scripts/publish.sh --dry-run",
    "publish:npm": "./scripts/publish.sh",
    "docker:build": "DOCKER_BUILDKIT=1 docker build --progress=plain -t occt-wasm .",
    "docker:dist": "DOCKER_BUILDKIT=1 docker build --progress=plain -t occt-wasm . && docker run --rm -v \"$(pwd)/dist:/out\" occt-wasm sh -c 'cp dist/* /out/'",
    "builder:build": "./scripts/builder-image.sh --build",
    "builder:push": "./scripts/builder-image.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "^21",
    "@commitlint/config-conventional": "^21",
    "@playwright/test": "^1.62.0",
    "@types/node": "^26",
    "husky": "^9",
    "opencascade.js": "^1.1.1",
    "three": "0.185.1",
    "vitest": "^4.1.10",
    "webpack": "^5.109.2"
  }
}
